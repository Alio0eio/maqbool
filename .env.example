NODE_ENV=development
PORT=5000
# For the standalone Vite dev server; use /api when served by the API server.
VITE_API_BASE_URL=http://localhost:5000/api
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
JWT_SECRET=replace-with-a-development-secret-at-least-16-characters
JWT_ACCESS_SECRET=replace-with-a-development-access-secret
JWT_REFRESH_SECRET=replace-with-a-development-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
# Local development stores private resumes in .local-data/candidate-resumes.
# Production requires server-side S3-compatible storage credentials. Endpoint is optional for AWS S3.
RESUME_S3_ENDPOINT=
RESUME_S3_REGION=us-east-1
RESUME_S3_BUCKET=
RESUME_S3_ACCESS_KEY_ID=
RESUME_S3_SECRET_ACCESS_KEY=
# Optional local development storage directory override.
# RESUME_STORAGE_DIR=
DATABASE_URL=postgresql://user:password@localhost:5432/empo